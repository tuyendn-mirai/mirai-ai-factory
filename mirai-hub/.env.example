# Generate with `uv run chainlit create-secret` — required to boot the app.
CHAINLIT_AUTH_SECRET=

# Dev-only password login (see mirai_hub/auth.py) — NOT for production use.
DEV_ADMIN_PASSWORD=admin

# Official Chainlit data layer — Postgres (threads/steps/users/elements/feedback)
# shares the "ai_factory" DB with litellm/langfuse, isolated via schema instead of
# a dedicated database (see mirai_hub/data_layer.py). From this dev machine, the
# DB/MinIO are reachable at localhost; in-cluster they're host.k3d.internal.
DATABASE_URL=postgresql+asyncpg://mirai:password@localhost:5435/ai_factory
DATABASE_SCHEMA=miraihub

# Official Chainlit data layer — S3-compatible storage (MinIO) for file elements.
BUCKET_NAME=miraihub
APP_AWS_ACCESS_KEY=mirahub
APP_AWS_SECRET_KEY=
APP_AWS_REGION=ap-northeast-1
DEV_AWS_ENDPOINT=http://localhost:9100

# Layer 3 — LiteLLM proxy (OpenAI-compatible), used as the chat model backend.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LLM_MODEL=gemma4:e4b

# Layer 4 — langflow-runtime, source of the per-thread MCP server picker.
LANGFLOW_RUNTIME_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=
