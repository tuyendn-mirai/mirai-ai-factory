# Generate with `uv run chainlit create-secret` — required to boot the app.
CHAINLIT_AUTH_SECRET=

# Layer 4 — langflow-runtime (see infra/apps/langflow-runtime/README.md)
LANGFLOW_RUNTIME_BASE_URL=http://langflow-runtime.mirai.local
LANGFLOW_API_KEY=

# Layer 5 session/chat history persistence — shares Postgres `ai_factory`
# with litellm/langfuse (host.k3d.internal:5435 from in-cluster,
# localhost:5435 from this dev machine), separated by schema instead of a
# dedicated database (see mirai_hub/data_layer.py for why schema isn't in
# the URL itself). Leave DATABASE_URL unset to run with in-memory sessions
# only (no history across restarts).
DATABASE_URL=postgresql+asyncpg://mirai:password@host.k3d.internal:5435/ai_factory
DATABASE_SCHEMA=miraihub

# Dev-only password login (see mirai_hub/auth.py) — NOT for production use.
DEV_ADMIN_PASSWORD=admin
DEV_ANALYST_PASSWORD=analyst

# Keycloak SSO — unset = only dev password login is offered (see README).
# Keycloak is not deployed in this platform yet (PLATFORM.md).
OAUTH_KEYCLOAK_CLIENT_ID=
OAUTH_KEYCLOAK_CLIENT_SECRET=
OAUTH_KEYCLOAK_REALM=
OAUTH_KEYCLOAK_BASE_URL=
