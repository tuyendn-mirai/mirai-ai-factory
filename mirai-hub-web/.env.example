# FastAPI backend's base URL, reachable from wherever this Next.js
# server runs (BFF route handlers in src/app/api/** proxy to it).
# In-cluster this is the mirai-hub-api ClusterIP service DNS name; for
# local dev, run mirai-hub-api on localhost:8000 and leave the default.
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional — best-effort "Mở trong Langflow" deep link on the MCP
# servers catalog page. The API contract doesn't expose this per project,
# so it's built client-side as `${NEXT_PUBLIC_LANGFLOW_URL}/flow/{id}`.
NEXT_PUBLIC_LANGFLOW_URL=http://langflow.mirai.local
