# Copy file này thành .env rồi điền LOCALSTACK_AUTH_TOKEN thật — bắt buộc,
# docker-compose.yml sẽ fail rõ ràng nếu thiếu.
DEBUG=0

# Gói Student (miễn phí, cần verify GitHub Student Developer Pack) —
# localstack.cloud/localstack-for-students. Bật được PERSISTENCE=1 +
# ENFORCE_IAM=1 thật — NHƯNG chỉ với image tag đủ mới (đang pin
# 2026.7.5 trong docker-compose.yml); bản quá cũ (từng pin 4.13.1 để né
# token) không tích hợp license flow cho tier Student, set token vào đó vẫn
# không kích hoạt được gì (xem localstack/README.md). KHÔNG commit giá trị
# thật vào đây, chỉ .env.example này lên git, .env thật đã trong .gitignore.
LOCALSTACK_AUTH_TOKEN=
