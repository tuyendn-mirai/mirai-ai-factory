# Copy thành .env rồi điền giá trị thật. Không commit .env.

# Khóa gọi vào LiteLLM Proxy (Tầng 3) — Tầng 4 (Langflow) dùng khóa này
# làm "OpenAI API Key" khi trỏ base_url vào http://litellm:4000
LITELLM_MASTER_KEY=sk-mirai-local

# ── Đăng nhập UI Langflow (bắt buộc, đã tắt auto-login) ──
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=<đặt password đăng nhập UI Langflow>

# ── Postgres server đã dựng sẵn (server khác, không phải container ở đây) ──
# Bắt buộc phải đặt — LiteLLM sẽ không khởi động nếu thiếu biến này.
# `?schema=litellm` tách riêng bảng của LiteLLM (LiteLLM_SpendLogs...) vào
# một schema riêng, không đụng bảng của layer/app khác cùng chung database.
# Tạo schema đó trước 1 lần trên Postgres server (xem README mục 1):
#   CREATE SCHEMA IF NOT EXISTS litellm;
# rồi LiteLLM sẽ tự tạo bảng bên trong ở lần chạy đầu.
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>?schema=litellm

# ── Ollama server đã dựng sẵn (server khác, không phải container ở đây) ──
# Bắt buộc phải đặt — LiteLLM sẽ không khởi động nếu thiếu biến này.
# Không cần API key.
OLLAMA_BASE_URL=http://<ollama-server-host>:11434

# ── Vendor keys (Tầng 2, tuỳ chọn) — chỉ cần khi bật thêm entry vendor
# thật (OpenAI/Anthropic/Bedrock) trong layer3-litellm/config.yaml.
# Không bắt buộc cho POC dùng Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# ── Langflow: DATABASE riêng (không share qua schema) ──
# Đã thử "?options=-c search_path=..." để share chung database với
# LiteLLM/Langfuse, nhưng Langflow không áp dụng đáng tin cậy (migration
# Alembic không chạy đúng schema -> lỗi "relation user does not exist" khi
# chạy thật). Langflow không dùng Prisma nên không có cách chia schema
# chính thức nào — dùng DATABASE riêng cho chắc.
# Tạo trước 1 lần: CREATE DATABASE langflow;
LANGFLOW_DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/langflow

# ── Langfuse (self-host) — cũng share chung database, dùng "?schema=" bình
# thường vì Langfuse dùng Prisma (giống LiteLLM). Tạo schema trước 1 lần:
#   CREATE SCHEMA IF NOT EXISTS langfuse;
#   GRANT ALL ON SCHEMA langfuse TO <user>;
LANGFUSE_DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>?schema=langfuse

# Sinh ngẫu nhiên 1 lần, giữ nguyên về sau (đổi sẽ mất khả năng đọc lại dữ
# liệu đã mã hoá):
#   openssl rand -base64 32   ->  LANGFUSE_SALT, NEXTAUTH_SECRET
#   openssl rand -hex 32      ->  LANGFUSE_ENCRYPTION_KEY
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── ClickHouse server đã dựng sẵn (server khác) — lưu trace/analytics ──
# Database riêng, không dùng "default" (server dùng chung với app khác).
# Tạo trước 1 lần trên ClickHouse server: CREATE DATABASE IF NOT EXISTS langfuse;
CLICKHOUSE_MIGRATION_URL=clickhouse://<clickhouse-host>:9000
CLICKHOUSE_URL=http://<clickhouse-host>:8123
CLICKHOUSE_USER=<user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=langfuse

# ── MinIO/S3 server đã dựng sẵn (server khác) — cần tạo bucket "langfuse"
# trước (đổi LANGFUSE_S3_BUCKET nếu dùng tên khác) ──
MINIO_ENDPOINT=http://<minio-host>:9000
MINIO_ROOT_USER=<access-key>
MINIO_ROOT_PASSWORD=<secret-key>
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=auto

# ── Redis server đã dựng sẵn (server khác) — LiteLLM và Langfuse dùng
# CHUNG server nhưng KHÁC DB index để không đụng key của nhau ──
# LiteLLM: cache response, dùng host/port/password riêng (litellm cần từng
# phần, không nhận URL đầy đủ) + DB index qua LITELLM_REDIS_DB.
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<password>
LITELLM_REDIS_DB=1

# Langfuse: nhận URL đầy đủ, nhớ đặt path là DB index KHÁC với LITELLM_REDIS_DB
# ở trên (vd /2 nếu LiteLLM dùng /1).
REDIS_CONNECTION_STRING=redis://:<password>@<redis-host>:6379/2

# Điền SAU khi chạy `docker compose up -d`, mở http://localhost:3000, tạo
# user/org/project đầu tiên, vào Settings > API Keys > Create new — rồi
# `docker compose up -d langflow` lại để Langflow nhận key mới.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
