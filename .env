# Copy thành .env rồi điền giá trị thật. Không commit .env.

# Khóa gọi vào LiteLLM Proxy (Tầng 3) — Tầng 4 (Langflow) dùng khóa này
# làm "OpenAI API Key" khi trỏ base_url vào http://litellm:4000
LITELLM_MASTER_KEY=sk-mirai-local

# ── Đăng nhập UI Langflow (bắt buộc, đã tắt auto-login) ──
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=Adgjmptw1

# ── Postgres server đã dựng sẵn (server khác, không phải container ở đây) ──
# Bắt buộc phải đặt — LiteLLM sẽ không khởi động nếu thiếu biến này.
DATABASE_URL=postgresql://mirai:Adgjmptw1@172.16.0.191:5435/ai_factory?schema=litellm

# ── Ollama server đã dựng sẵn (server khác, không phải container ở đây) ──
# Bắt buộc phải đặt — LiteLLM sẽ không khởi động nếu thiếu biến này.
# Không cần API key.
OLLAMA_BASE_URL=http://172.16.0.191:11434

# ── Vendor keys (Tầng 2, tuỳ chọn) — chỉ cần khi bật thêm entry vendor
# thật (OpenAI/Anthropic/Bedrock) trong layer3-litellm/config.yaml.
# Không bắt buộc cho POC dùng Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# ── Langflow: DATABASE riêng (không share qua schema) ──
# Đã thử "?options=-c search_path=..." nhưng Langflow không áp dụng đáng
# tin cậy (migration Alembic không chạy đúng schema -> lỗi "relation user
# does not exist"). Langflow không phải Prisma nên không có cách chia
# schema chính thức nào được hỗ trợ — dùng DATABASE riêng cho chắc.
# TODO: chạy trước 1 lần trên Postgres server: CREATE DATABASE langflow;
LANGFLOW_DATABASE_URL=postgresql://mirai:Adgjmptw1@172.16.0.191:5435/langflow

# ── Langfuse (self-host) — cũng share database "ai_factory", dùng "?schema="
# bình thường vì Langfuse dùng Prisma (giống LiteLLM). Tạo schema trước:
#   CREATE SCHEMA IF NOT EXISTS langfuse;
#   GRANT ALL ON SCHEMA langfuse TO mirai;
LANGFUSE_DATABASE_URL=postgresql://mirai:Adgjmptw1@172.16.0.191:5435/ai_factory?schema=langfuse

# Đã tự sinh random 1 lần (an toàn để giữ, chỉ Langfuse dùng nội bộ) —
# đừng đổi sau khi đã có dữ liệu, đổi sẽ mất khả năng đọc lại dữ liệu mã hoá.
LANGFUSE_SALT=fqQqfZJ+3ppm5LBLyiA00I4Cd/GLWg/AApygkO/HrBM=
LANGFUSE_ENCRYPTION_KEY=f7ba6e5fab85c550ac77042c300d5bf5b632a43406d37d934105732159473a61
NEXTAUTH_SECRET=d/N4lKAMRxoaGbRhowCmYaQKDghEcB/WyOk5zq9oDGQ=
NEXTAUTH_URL=http://localhost:3000
    
# ── ClickHouse server đã dựng sẵn (server khác) ──
# TODO: điền host/user/password thật
# Database riêng, không dùng "default". Tạo trước 1 lần trên ClickHouse:
#   CREATE DATABASE IF NOT EXISTS langfuse;
CLICKHOUSE_MIGRATION_URL=clickhouse://172.16.0.191:9004
CLICKHOUSE_URL=http://172.16.0.191:8123
CLICKHOUSE_USER=mirai
CLICKHOUSE_PASSWORD=Adgjmptw1
CLICKHOUSE_DB=langfuse

# ── MinIO/S3 server đã dựng sẵn (server khác) — nhớ tạo bucket "langfuse"
# trước khi chạy ──
# TODO: điền endpoint/access key/secret key thật
MINIO_ENDPOINT=http://172.16.0.191:9100
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=Adgjmptw1
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=auto

# ── Redis server đã dựng sẵn (server khác) — LiteLLM và Langfuse dùng
# CHUNG server nhưng KHÁC DB index để không đụng key của nhau ──
REDIS_HOST=172.16.0.191
REDIS_PORT=6380
REDIS_PASSWORD=Adgjmptw1
LITELLM_REDIS_DB=1

REDIS_CONNECTION_STRING=redis://:Adgjmptw1@172.16.0.191:6380/2

# Điền SAU khi chạy `docker compose up -d`, mở http://localhost:3000, tạo
# user/org/project đầu tiên, vào Settings > API Keys > Create new — rồi
# `docker compose up -d langflow` lại để Langflow nhận key mới.
LANGFUSE_PUBLIC_KEY=pk-lf-3a992d47-aa05-4508-9168-5b3fa9eadd6c
LANGFUSE_SECRET_KEY=sk-lf-fda8e66d-61e3-452a-957f-ab27030b64eb
